generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  DISTRIBUTOR
  RETAILER
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum DocumentType {
  PAN_CERTIFICATE
  BUSINESS_REGISTRATION
  CITIZENSHIP
  TAX_CLEARANCE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitType {
  PIECE
  PACK
  CARTON
  BOX
  BAG
  BOTTLE
  CAN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ESEWA
  KHALTI
  FONEPAY
  BANK_TRANSFER
}

enum DeliveryStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  ATTEMPTED
  FAILED
}

enum CommissionTxType {
  EARNING
  DEDUCTION
  PAYOUT
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  role             Role                @default(RETAILER)
  status           UserStatus          @default(ACTIVE)
  fullName         String
  phone            String?
  avatarUrl        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  retailerProfile    RetailerProfile?
  distributorProfile DistributorProfile?
  addresses          Address[]
  documents          BusinessDocument[]
  cart               Cart?
  ordersAsRetailer   Order[]             @relation("RetailerOrders")
  notifications      Notification[]
  reviews            Review[]
  wishlists          Wishlist[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model RetailerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String
  panVatNumber    String?
  province        String
  district        String
  municipality    String
  ward            String
  landmark        String?
  streetAddress   String
  businessType    String?     @default("Grocery Store")
  creditLimit     Decimal     @default(0.00) @db.Decimal(12, 2)
  isVerified      Boolean     @default(false)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([province, district])
  @@index([shopName])
}

model DistributorProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  panVatNumber       String
  registrationNumber String?
  province           String
  district           String
  municipality       String
  ward               String
  streetAddress      String
  contactPerson      String
  contactPhone       String
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  commissionRate     Decimal             @default(3.00) @db.Decimal(5, 2) // default 3%
  isVerified         Boolean             @default(false)
  rating             Decimal             @default(4.8) @db.Decimal(3, 2)
  minOrderAmount     Decimal             @default(1000.00) @db.Decimal(10, 2)
  deliveryZones      String?             // JSON or comma-separated list of covered areas
  logoUrl            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  products           Product[]
  companies          DistributorCompany[]
  offers             Offer[]
  orders             Order[]
  invoices           Invoice[]
  deliveries         Delivery[]
  commissions        Commission[]
  transactions       CommissionTransaction[]

  @@index([companyName])
  @@index([province, district])
  @@index([isVerified])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Shop") // Shop, Warehouse, Office
  contactName   String
  phone         String
  province      String
  district      String
  municipality  String
  ward          String
  streetAddress String
  landmark      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model BusinessDocument {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType DocumentType   @default(PAN_CERTIFICATE)
  documentUrl  String
  status       DocumentStatus @default(PENDING)
  remarks      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  iconName    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id              String         @id @default(cuid())
  distributorId   String
  distributor     DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId         String?
  brand           Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  companyName     String?        // Principal company/manufacturer (e.g. Unilever Nepal, Dabur Nepal, CG Foods)
  title           String
  slug            String         @unique
  sku             String         @unique
  description     String?
  unitType        UnitType       @default(PIECE)
  packSize        String?        // e.g. "12 Pcs" or "1 kg"
  unitsPerCarton  Int            @default(24)
  mrp             Decimal        @db.Decimal(10, 2)
  wholesalePrice  Decimal        @db.Decimal(10, 2)
  minOrderQty     Int            @default(1)
  stockQuantity   Int            @default(100)
  isAvailable     Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  isApproved      Boolean        @default(true)
  barcode         String?
  // Real-market wholesale schemes & offers
  hasFreeScheme   Boolean        @default(false)
  freeSchemeMinQty Int?          @default(10)
  freeItemName    String?
  freeItemQty     Int?           @default(1)
  freeSchemeType  String?        @default("SAME_PRODUCT") // "SAME_PRODUCT" | "ANOTHER_PRODUCT" | "UNSELLING_ITEM"
  freeProductId   String?        // Target product ID if another item is gifted
  freeItemSku     String?        // SKU of the free item
  hasUnsellingBonus Boolean      @default(false) // Whether an unselling/clearance dead stock gift is attached
  unsellingItemName String?      // Description of the unselling item (e.g. slow-moving stock, clearance goods)
  unsellingItemMinQty Int?       @default(2) // Min cartons to earn the unselling item
  unsellingItemQty Int?          @default(1) // Qty of unselling items awarded
  unsellingItemTag String?       // Tag: "CLEARANCE_STOCK", "DEAD_STOCK", "PROMO_GIFT"
  cashDiscountPercent Decimal    @default(2.00) @db.Decimal(5, 2)
  promotionalGift String?
  festivalTag     String?
  taxCategory     String         @default("TAXABLE_13")
  hsnCode         String?
  batchNumber     String?
  manufacturingDate DateTime?
  expiryDate      DateTime?
  shelfLife       String?
  creditTerms     String?
  returnPolicy    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  wholesalePrices WholesalePrice[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]
  inventoryLogs   Inventory[]

  @@index([distributorId])
  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([isAvailable])
  @@index([isFeatured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  @@index([productId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String   // e.g., "500ml", "1 Liter", "Red", "Blue"
  sku            String   @unique
  wholesalePrice Decimal  @db.Decimal(10, 2)
  stockQuantity  Int      @default(0)
  minOrderQty    Int      @default(1)

  @@index([productId])
}

model WholesalePrice {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity  Int      // e.g. 10 cartons
  maxQuantity  Int?     // e.g. 50 cartons
  pricePerUnit Decimal  @db.Decimal(10, 2) // Wholesale discounted rate for this quantity break

  @@index([productId])
}

model Offer {
  id             String       @id @default(cuid())
  distributorId  String
  distributor    DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  title          String
  code           String?      @unique
  description    String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10, 2)
  minCartonQty   Int          @default(1)
  minOrderAmount Decimal      @default(0.00) @db.Decimal(10, 2)
  startDate      DateTime     @default(now())
  endDate        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([distributorId])
  @@index([isActive])
}

model Inventory {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity           Int
  lowStockThreshold  Int      @default(10)
  lastRestockedAt    DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  unitType   UnitType @default(CARTON) // Wholesale default is Carton/Pack
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Order {
  id                    String         @id @default(cuid())
  orderNumber           String         @unique
  retailerId            String
  retailer              User           @relation("RetailerOrders", fields: [retailerId], references: [id], onDelete: Restrict)
  distributorId         String
  distributor           DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  status                OrderStatus    @default(PENDING)
  paymentStatus         PaymentStatus  @default(PENDING)
  paymentMethod         PaymentMethod  @default(CASH_ON_DELIVERY)
  subtotal              Decimal        @db.Decimal(12, 2)
  discountAmount        Decimal        @default(0.00) @db.Decimal(10, 2)
  deliveryFee           Decimal        @default(0.00) @db.Decimal(10, 2)
  taxAmount             Decimal        @default(0.00) @db.Decimal(10, 2)
  totalAmount           Decimal        @db.Decimal(12, 2)
  commissionRate        Decimal        @default(3.00) @db.Decimal(5, 2)
  commissionAmount      Decimal        @default(0.00) @db.Decimal(10, 2)
  netDistributorEarnings Decimal       @db.Decimal(12, 2)
  deliveryAddressJson   String         // Full snapshot of delivery address at checkout
  specialInstructions   String?
  notes                 String?
  deliveryDate          DateTime?
  deliveryTimeSlot      String?
  isInvoiced            Boolean        @default(false)
  invoiceNumber         String?
  confirmationNoticeJson String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  items                 OrderItem[]
  payments              Payment[]
  invoice               Invoice?
  delivery              Delivery?
  commissions           Commission[]

  @@index([orderNumber])
  @@index([retailerId])
  @@index([distributorId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle String
  productSku   String
  unitType     UnitType @default(CARTON)
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  isCancelled  Boolean  @default(false)
  cancelReason String?
  cancelledAt  DateTime?
  isInvoiced   Boolean  @default(false)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId      String?
  provider           PaymentMethod @default(CASH_ON_DELIVERY)
  amount             Decimal       @db.Decimal(12, 2)
  status             PaymentStatus @default(PENDING)
  paymentDetailsJson String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())

  @@index([orderId])
}

model Invoice {
  id            String             @id @default(cuid())
  invoiceNumber String             @unique
  orderId       String             @unique
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  distributorId String
  distributor   DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  retailerId    String
  taxableAmount Decimal            @db.Decimal(12, 2)
  vatAmount     Decimal            @db.Decimal(10, 2) // 13% VAT
  grandTotal    Decimal            @db.Decimal(12, 2)
  panVatSeller  String
  panVatBuyer   String?
  pdfUrl        String?
  status        String             @default("ISSUED") // ISSUED, PAID, CANCELLED
  createdAt     DateTime           @default(now())

  @@index([invoiceNumber])
  @@index([distributorId])
  @@index([retailerId])
}

model Delivery {
  id                 String             @id @default(cuid())
  orderId            String             @unique
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  distributorId      String
  distributor        DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  deliveryPersonName String?
  deliveryPersonPhone String?
  vehicleNumber      String?
  status             DeliveryStatus     @default(ASSIGNED)
  trackingCode       String?
  remarks            String?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([distributorId])
  @@index([status])
}

model Commission {
  id               String             @id @default(cuid())
  distributorId    String
  distributor      DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalOrderAmount Decimal            @db.Decimal(12, 2)
  commissionRate   Decimal            @db.Decimal(5, 2)
  commissionAmount Decimal            @db.Decimal(10, 2)
  isSettled        Boolean            @default(false)
  settledAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([distributorId])
  @@index([orderId])
}

model CommissionTransaction {
  id            String             @id @default(cuid())
  distributorId String
  distributor   DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  type          CommissionTxType
  amount        Decimal            @db.Decimal(12, 2)
  reference     String?
  notes         String?
  createdAt     DateTime           @default(now())

  @@index([distributorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId String
  retailer  User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
}

model DistributorCompany {
  id            String             @id @default(cuid())
  distributorId String
  distributor   DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  name          String
  shortCode     String?
  category      String?
  agencyCode    String?
  contactPerson String?
  contactPhone  String?
  logoUrl       String?
  isAuthorized  Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([distributorId])
}
